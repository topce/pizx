{
  "name": "@topce/pizx",
  "version": "1.4.1",
  "description": "zx fork with native Pi AI integration on the cordis plugin framework — shell scripting with AI agents, user-definable letter tags, traceable runs with JSONL log export, and a local result cache. Ships with π (text generation), Π (coding agent), and α (any ACP-compatible agent).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js",
      "default": "./dist/globals.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pizx": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:dts",
    "build:js": "node scripts/build.mjs",
    "build:dts": "tsc --project tsconfig.build.json",
    "dev": "node scripts/build.mjs --watch",
    "lint": "biome ci src/",
    "lint:biome": "biome ci src/",
    "lint:fix": "biome lint --write src/",
    "check": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "prepublishOnly": "npm run build",
    "example:hello": "node dist/cli.js examples/hello-pizx.mjs",
    "example:pi": "node dist/cli.js examples/basic-pi.mjs",
    "example:Pi": "node dist/cli.js examples/basic-capital-pi.mjs",
    "example:acp": "node dist/cli.js examples/acp-basic.mjs",
    "example:acp-word-slots": "node dist/cli.js examples/acp-word-slots.mjs",
    "example:quick": "node dist/cli.js examples/quick-ask.mjs",
    "example:custom": "node dist/cli.js --trace --export-log examples/custom-letter.mjs",
    "example:words": "node dist/cli.js examples/words.mjs",
    "example:word-ralph": "node dist/cli.js examples/word-ralph.mjs",
    "example:word-fleet": "node dist/cli.js examples/word-fleet.mjs",
    "example:word-chain": "node dist/cli.js examples/word-chain.mjs",
    "example:word-route": "node dist/cli.js examples/word-route.mjs",
    "example:word-vote": "node dist/cli.js examples/word-vote.mjs",
    "example:word-refine": "node dist/cli.js examples/word-refine.mjs",
    "example:word-orchestrate": "node dist/cli.js examples/word-orchestrate.mjs",
    "example:trace": "node dist/cli.js --cache --trace --export-log examples/trace-and-cache.mjs",
    "example:all": "npm run example:hello && npm run example:pi && npm run example:Pi && npm run example:custom && npm run example:trace"
  },
  "keywords": [
    "zx",
    "pi",
    "ai",
    "pi-ai",
    "pi-coding-agent",
    "shell",
    "script",
    "cli",
    "automation",
    "llm",
    "cordis",
    "plugin",
    "template-tag",
    "ai-scripting",
    "shell-scripting",
    "agentic",
    "trace",
    "cache"
  ],
  "author": "Slobodan Filipovic <topce@users.noreply.github.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/topce/pizx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topce/pizx.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@cordisjs/core": "^3.18.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "schemastery": "^3.18.0",
    "zx": "8.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "bugs": {
    "url": "https://github.com/topce/pizx/issues"
  }
}
